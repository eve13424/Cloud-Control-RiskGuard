# БЛОК ОПИСАНИЯ СИСТЕМНОГО ОКРУЖЕНИЯ
{ pkgs }: { # Описание окружения Replit через пакетный менеджер Nix.

  # БЛОК СИСТЕМНЫХ ЗАВИСИМОСТЕЙ
  deps = [ # Список системных пакетов, необходимых для запуска Python-приложения и графических библиотек.

    pkgs.cairo # Библиотека для работы с двумерной графикой и отрисовкой изображений.
    pkgs.ffmpeg-full # Пакет для обработки мультимедийных данных, используемый рядом визуализационных библиотек.
    pkgs.freetype # Библиотека для работы со шрифтами при построении графиков.
    pkgs.ghostscript # Пакет для обработки графических и печатных форматов.
    pkgs.glibcLocales # Пакет локалей для корректной работы языковых и региональных настроек.
    pkgs.gobject-introspection # Системная зависимость для библиотек графического окружения.
    pkgs.gtk3 # Библиотека графического интерфейса.
    pkgs.pkg-config # Утилита для поиска и подключения системных библиотек.
    pkgs.qhull # Библиотека вычислительной геометрии, используемая научными Python-библиотеками.
    pkgs.tcl # Системная библиотека для отдельных графических компонентов Python.
    pkgs.tk # Библиотека, применяемая Python для графических окон и визуализации.

  ]; # Завершение списка системных зависимостей.
}